MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/sih2026?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_ORIGIN=http://localhost:8081
PORT=3000

# Chess.com OAuth 2.0 / OIDC SSO
CHESS_OAUTH_CLIENT_ID=your-chess-com-oauth-client-id
# Optional for public PKCE clients; set if Chess.com issued a client secret:
CHESS_OAUTH_CLIENT_SECRET=
# Must match the redirect URI registered with Chess.com (defaults to http://localhost:3000/auth/chess/callback):
CHESS_OAUTH_REDIRECT_URI=http://localhost:3000/auth/chess/callback
CHESS_OAUTH_SCOPES=openid profile
CHESS_USER_AGENT=UberDaps/1.0 (https://uberdaps.app)
# Optional OIDC discovery / JWKS overrides (auto-discovered from oauth.chess.com by default):
CHESS_OAUTH_DISCOVERY_URL=https://oauth.chess.com/.well-known/openid-configuration
CHESS_OAUTH_JWKS_URL=https://oauth.chess.com/.well-known/jwks.json
CHESS_OAUTH_ISSUER=https://oauth.chess.com
# Optional public backend base URL used when CHESS_OAUTH_REDIRECT_URI is omitted:
PUBLIC_BACKEND_URL=


{
  "expo": {
    "name": "frontend",
    "slug": "frontend",
    "scheme": "uberdaps",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location when going online as a Dapper."
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "UberDaps",
      "shortName": "UberDaps",
      "description": "Find a nearby dapper for your next handshake.",
      "themeColor": "#000000",
      "backgroundColor": "#ffffff",
      "display": "standalone",
      "startUrl": "/",
      "scope": "/"
    }
  }
}
